# Local API. Management routes require this bearer token.
APP_API_TOKEN=replace-with-a-long-random-token
# Local Attendee callbacks use the API service on the shared Compose network.
# For hosted Attendee, use a public HTTPS tunnel URL.
APP_PUBLIC_URL=http://api:5005
APP_PORT=5005
LOCAL_DASHBOARD_PORT=5006
DATABASE_PATH=./data/jira_bot.sqlite3

# Attendee (the webhook secret is the base64 secret from Settings -> Webhooks)
ATTENDEE_API_KEY=
ATTENDEE_WEBHOOK_SECRET=
ATTENDEE_API_BASE=http://127.0.0.1:8000/api/v1
ATTENDEE_BOT_NAME=Jira Meeting Assistant

# Screen-share frames are sensitive and disabled unless explicitly enabled.
SCREENSHARE_CAPTURE_ENABLED=false
SCREENSHARE_WEBSOCKET_TOKEN=
# Attendee requires wss:// for video. The local api-tls proxy serves it on the Compose
# network with a certificate from the local CA that scripts/dev.py creates in certs/.
# Leave empty to derive the URL from APP_PUBLIC_URL (which must then be HTTPS).
SCREENSHARE_WEBSOCKET_BASE_URL=https://api-tls:8443
SCREENSHARE_RESOLUTION=360p
SCREENSHARE_SAMPLE_INTERVAL_SECONDS=10
SCREENSHARE_RETENTION_HOURS=24
SCREENSHARE_MAX_FRAMES_PER_MEETING=600
SCREENSHARE_CONTEXT_WINDOW_SECONDS=30
SCREENSHARE_VISION_ENABLED=true
# Jira issue attachments duplicate screen content; enable only if approved.
JIRA_ATTACH_SCREENSHARE_EVIDENCE=false

# Optional Google Calendar read-only auto-join. Keep disabled until OAuth is configured.
# A public HTTPS APP_PUBLIC_URL enables push notifications; local Compose polls as fallback.
GOOGLE_CALENDAR_AUTO_JOIN_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_EVENT_TITLE=
# Optional extra allowlist check; exact organizer email, case-insensitive.
GOOGLE_CALENDAR_ORGANIZER_EMAIL=
GOOGLE_CALENDAR_TIME_ZONE=America/Los_Angeles
GOOGLE_CALENDAR_START_TIME=10:00
GOOGLE_CALENDAR_POLL_SECONDS=60
GOOGLE_CALENDAR_JOIN_LEAD_MINUTES=5
GOOGLE_CALENDAR_JOIN_GRACE_MINUTES=2

# Auto-leave after a confident local-model wrap-up plus a quiet confirmation window.
MEETING_AUTO_LEAVE_ENABLED=true
MEETING_LEAVE_QUIET_SECONDS=90
MEETING_LEAVE_MAX_OVERRUN_MINUTES=60
MEETING_LEAVE_MAX_RUNTIME_MINUTES=120
MEETING_LEAVE_CONFIDENCE_THRESHOLD=0.9

# Local MLX Whisper service. Use a long random token shared by the API and service.
MLX_TRANSCRIBER_API_KEY=replace-with-a-long-random-token
MLX_TRANSCRIBER_HEALTH_URL=http://host.docker.internal:8101/health
MLX_WHISPER_MODEL=mlx-community/whisper-turbo
# Leave empty to let Whisper detect the language.
MLX_WHISPER_LANGUAGE=

# OpenAI-compatible local vLLM server running Gemma
LLM_BASE_URL=http://127.0.0.1:8100/v1
LLM_BASE_URL_DOCKER=http://host.docker.internal:8100/v1
LLM_API_KEY=local
LLM_MODEL=mlx-community/gemma-4-e4b-it-4bit
LLM_CONTEXT_TOKENS=16384
LLM_MAX_COMPLETION_TOKENS=2048
LLM_CONFIDENCE_THRESHOLD=0.85

# Keep true for review-only proposals. Set false only when ready to create Jira issues.
JIRA_DRY_RUN=true
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
# Only assign Zachary or Zac when that exact name is spoken in the task evidence.
# Map either eligible name to its Jira account ID; all other owners stay unassigned.
JIRA_SPEAKER_ACCOUNT_IDS={}
# Example: {"High":"High","Medium":"Medium","Low":"Low"}
JIRA_PRIORITY_MAP={}
